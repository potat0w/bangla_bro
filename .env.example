# Groq chat model
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b

# Embeddings (local SentenceTransformer — multilingual for Bangla)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Paths (relative to project root)
PDF_PATH=data/Balladesh.pdf
OCR_OUTPUT_DIR=ocr_output
VECTORSTORE_DIR=vectorstore
COLLECTION=balladesh

# RAG chunking (DocuMind uses RecursiveCharacterTextSplitter; Balladesh OCR-tuned)
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=5

# OCR (ben+eng for mixed Bangla/English scans; use ben for Bangla-only)
TESSERACT_LANG=ben+eng
OCR_DPI=300

# API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
